# Static analysis against Shopware 5.7 (5.7.19/5.7.20).
# Requires a Shopware 5.7 installation with its dependencies, given via the
# environment variable SHOPWARE_ROOT, e.g.
#   SHOPWARE_ROOT=/var/www/shopware-5.7 vendor/bin/phpstan analyse
# The Shopware 5.6 adapters are analysed by phpstan-sw56.neon.dist.

includes:
    - phpstan.common.neon

parameters:
    excludePaths:
        - Components/Compat/Sw56
    tmpDir: .phpstan.cache/sw57
