<?xml version="1.0" encoding="utf-8"?>
<container xmlns="http://symfony.com/schema/dic/services"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd">

    <services>
        <!-- Event subscribers and console commands must be public in Shopware 5.6 (Symfony 3.4). -->
        <defaults public="false"/>

        <service id="Sw5CommunitySecurity\Components\Config\PluginConfigProvider"
                 class="Sw5CommunitySecurity\Components\Config\PluginConfigProvider">
            <argument type="service" id="Sw5CommunitySecurity\Components\Config\ConfigReader"/>
            <argument type="service" id="service_container"/>
            <argument>%sw5_community_security.plugin_name%</argument>
        </service>

        <service id="Sw5CommunitySecurity\Subscriber\SecurityHeaderSubscriber"
                 class="Sw5CommunitySecurity\Subscriber\SecurityHeaderSubscriber" public="true">
            <argument type="service" id="Sw5CommunitySecurity\Components\Config\PluginConfigProvider"/>
            <tag name="shopware.event_subscriber"/>
        </service>

        <service id="Sw5CommunitySecurity\Components\TemplateGuard\TemplateInspector"
                 class="Sw5CommunitySecurity\Components\TemplateGuard\TemplateInspector"/>

        <service id="Sw5CommunitySecurity\Components\Messages\SnippetMessageCatalog"
                 class="Sw5CommunitySecurity\Components\Messages\SnippetMessageCatalog">
            <argument type="service" id="snippets"/>
        </service>

        <service id="Sw5CommunitySecurity\Components\Messages\MessageFormatter"
                 class="Sw5CommunitySecurity\Components\Messages\MessageFormatter">
            <argument type="service" id="Sw5CommunitySecurity\Components\Messages\SnippetMessageCatalog"/>
        </service>

        <service id="Sw5CommunitySecurity\Components\TemplateGuard\TemplateGuard"
                 class="Sw5CommunitySecurity\Components\TemplateGuard\TemplateGuard">
            <argument type="service" id="Sw5CommunitySecurity\Components\TemplateGuard\TemplateInspector"/>
            <argument type="service" id="Sw5CommunitySecurity\Components\Messages\MessageFormatter"/>
        </service>

        <service id="Sw5CommunitySecurity\Subscriber\TemplateGuardSubscriber"
                 class="Sw5CommunitySecurity\Subscriber\TemplateGuardSubscriber" public="true">
            <argument type="service" id="Sw5CommunitySecurity\Components\Config\PluginConfigProvider"/>
            <argument type="service" id="Sw5CommunitySecurity\Components\TemplateGuard\TemplateGuard"/>
            <argument type="service" id="sw5_community_security.logger"/>
            <tag name="shopware.event_subscriber"/>
        </service>

        <service id="Sw5CommunitySecurity\Components\TemplateGuard\StoredTemplateScanner"
                 class="Sw5CommunitySecurity\Components\TemplateGuard\StoredTemplateScanner">
            <argument type="service" id="Sw5CommunitySecurity\Components\Database\RowReader"/>
            <argument type="service" id="Sw5CommunitySecurity\Components\TemplateGuard\TemplateGuard"/>
        </service>

        <service id="Sw5CommunitySecurity\Commands\TemplateGuardScanCommand"
                 class="Sw5CommunitySecurity\Commands\TemplateGuardScanCommand" public="true">
            <argument type="service" id="Sw5CommunitySecurity\Components\TemplateGuard\StoredTemplateScanner"/>
            <tag name="console.command" command="sw5cs:template-guard:scan"/>
        </service>

        <service id="Sw5CommunitySecurity\Components\UploadGuard\UploadInspector"
                 class="Sw5CommunitySecurity\Components\UploadGuard\UploadInspector"/>

        <service id="Sw5CommunitySecurity\Subscriber\UploadGuardSubscriber"
                 class="Sw5CommunitySecurity\Subscriber\UploadGuardSubscriber" public="true">
            <argument type="service" id="Sw5CommunitySecurity\Components\Config\PluginConfigProvider"/>
            <argument type="service" id="Sw5CommunitySecurity\Components\UploadGuard\UploadInspector"/>
            <argument type="service" id="shopware_media.media_service"/>
            <argument type="service" id="Sw5CommunitySecurity\Components\Messages\MessageFormatter"/>
            <argument type="service" id="sw5_community_security.logger"/>
            <tag name="shopware.event_subscriber"/>
        </service>

        <service id="Sw5CommunitySecurity\Components\JavaScriptEscape\JavaScriptEscapeHardening"
                 class="Sw5CommunitySecurity\Components\JavaScriptEscape\JavaScriptEscapeHardening"/>

        <!-- Registered on the "template" service by DependencyInjection\TemplateFilterCompilerPass. -->
        <service id="Sw5CommunitySecurity\Components\JavaScriptEscape\CompiledTemplateFilter"
                 class="Sw5CommunitySecurity\Components\JavaScriptEscape\CompiledTemplateFilter">
            <argument type="service" id="Sw5CommunitySecurity\Components\Config\PluginConfigProvider"/>
            <argument type="service" id="Sw5CommunitySecurity\Components\JavaScriptEscape\JavaScriptEscapeHardening"/>
        </service>

        <service id="Sw5CommunitySecurity\Components\SecurityCheck\SecurityCheck"
                 class="Sw5CommunitySecurity\Components\SecurityCheck\SecurityCheck"/>

        <service id="Sw5CommunitySecurity\Components\SecurityCheck\EnvironmentCollector"
                 class="Sw5CommunitySecurity\Components\SecurityCheck\EnvironmentCollector">
            <argument type="service" id="service_container"/>
            <argument type="service" id="Sw5CommunitySecurity\Components\Database\RowReader"/>
        </service>

        <!-- Public: fetched by the backend controller Sw5csSecurityCheck. -->
        <service id="Sw5CommunitySecurity\Components\SecurityCheck\SecurityCheckRunner"
                 class="Sw5CommunitySecurity\Components\SecurityCheck\SecurityCheckRunner" public="true">
            <argument type="service" id="Sw5CommunitySecurity\Components\SecurityCheck\EnvironmentCollector"/>
            <argument type="service" id="Sw5CommunitySecurity\Components\SecurityCheck\SecurityCheck"/>
            <argument type="service" id="Sw5CommunitySecurity\Components\Config\PluginConfigProvider"/>
            <argument type="service" id="Sw5CommunitySecurity\Components\Messages\MessageFormatter"/>
        </service>

        <service id="Sw5CommunitySecurity\Commands\SecurityCheckCommand"
                 class="Sw5CommunitySecurity\Commands\SecurityCheckCommand" public="true">
            <argument type="service" id="Sw5CommunitySecurity\Components\SecurityCheck\SecurityCheckRunner"/>
            <tag name="console.command" command="sw5cs:security-check"/>
        </service>

        <service id="Sw5CommunitySecurity\Subscriber\ConfigCacheSubscriber"
                 class="Sw5CommunitySecurity\Subscriber\ConfigCacheSubscriber" public="true">
            <argument>%sw5_community_security.plugin_name%</argument>
            <argument type="service" id="shopware.cache_manager"/>
            <tag name="shopware.event_subscriber"/>
        </service>
        <!-- Public: used by the backend controller Sw5csSecurityCheck. -->
        <service id="Sw5CommunitySecurity\Components\ProtectionFiles\ProtectionFiles"
                 class="Sw5CommunitySecurity\Components\ProtectionFiles\ProtectionFiles" public="true"/>

        <service id="Sw5CommunitySecurity\Components\ProtectionFiles\AutoRestore"
                 class="Sw5CommunitySecurity\Components\ProtectionFiles\AutoRestore">
            <argument type="service" id="Sw5CommunitySecurity\Components\Config\PluginConfigProvider"/>
            <argument type="service" id="Sw5CommunitySecurity\Components\ProtectionFiles\ProtectionFiles"/>
            <argument>%kernel.root_dir%</argument>
            <argument type="service" id="sw5_community_security.logger"/>
        </service>

        <service id="Sw5CommunitySecurity\Subscriber\ProtectionFileSubscriber"
                 class="Sw5CommunitySecurity\Subscriber\ProtectionFileSubscriber" public="true">
            <argument type="service" id="Sw5CommunitySecurity\Components\ProtectionFiles\AutoRestore"/>
            <tag name="shopware.event_subscriber"/>
        </service>

        <service id="Sw5CommunitySecurity\Commands\ProtectionFilesRestoreCommand"
                 class="Sw5CommunitySecurity\Commands\ProtectionFilesRestoreCommand" public="true">
            <argument type="service" id="Sw5CommunitySecurity\Components\ProtectionFiles\ProtectionFiles"/>
            <argument>%kernel.root_dir%</argument>
            <tag name="console.command" command="sw5cs:protection-files:restore"/>
        </service>
    </services>
</container>
