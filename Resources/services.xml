<?xml version="1.0" encoding="utf-8"?>
<container xmlns="http://symfony.com/schema/dic/services"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd">

    <services>
        <defaults public="false"/>

        <service id="Sw5CommunitySecurity\Components\Config\PluginConfigProvider"
                 class="Sw5CommunitySecurity\Components\Config\PluginConfigProvider">
            <argument type="service" id="Shopware\Components\Plugin\Configuration\CachedReader"/>
            <argument type="service" id="service_container"/>
            <argument>%sw5_community_security.plugin_name%</argument>
        </service>

        <service id="Sw5CommunitySecurity\Subscriber\SecurityHeaderSubscriber"
                 class="Sw5CommunitySecurity\Subscriber\SecurityHeaderSubscriber">
            <argument type="service" id="Sw5CommunitySecurity\Components\Config\PluginConfigProvider"/>
            <tag name="shopware.event_subscriber"/>
        </service>

        <service id="Sw5CommunitySecurity\Components\TemplateGuard\TemplateInspector"
                 class="Sw5CommunitySecurity\Components\TemplateGuard\TemplateInspector"/>

        <service id="Sw5CommunitySecurity\Components\TemplateGuard\TemplateGuard"
                 class="Sw5CommunitySecurity\Components\TemplateGuard\TemplateGuard">
            <argument type="service" id="Sw5CommunitySecurity\Components\TemplateGuard\TemplateInspector"/>
        </service>

        <service id="Sw5CommunitySecurity\Subscriber\TemplateGuardSubscriber"
                 class="Sw5CommunitySecurity\Subscriber\TemplateGuardSubscriber">
            <argument type="service" id="Sw5CommunitySecurity\Components\Config\PluginConfigProvider"/>
            <argument type="service" id="Sw5CommunitySecurity\Components\TemplateGuard\TemplateGuard"/>
            <tag name="shopware.event_subscriber"/>
        </service>

        <service id="Sw5CommunitySecurity\Components\TemplateGuard\StoredTemplateScanner"
                 class="Sw5CommunitySecurity\Components\TemplateGuard\StoredTemplateScanner">
            <argument type="service" id="dbal_connection"/>
            <argument type="service" id="Sw5CommunitySecurity\Components\TemplateGuard\TemplateGuard"/>
        </service>

        <service id="Sw5CommunitySecurity\Commands\TemplateGuardScanCommand"
                 class="Sw5CommunitySecurity\Commands\TemplateGuardScanCommand">
            <argument type="service" id="Sw5CommunitySecurity\Components\TemplateGuard\StoredTemplateScanner"/>
            <tag name="console.command" command="sw5cs:template-guard:scan"/>
        </service>
        <service id="Sw5CommunitySecurity\Components\UploadGuard\UploadInspector"
                 class="Sw5CommunitySecurity\Components\UploadGuard\UploadInspector"/>

        <service id="Sw5CommunitySecurity\Subscriber\UploadGuardSubscriber"
                 class="Sw5CommunitySecurity\Subscriber\UploadGuardSubscriber">
            <argument type="service" id="Sw5CommunitySecurity\Components\Config\PluginConfigProvider"/>
            <argument type="service" id="Sw5CommunitySecurity\Components\UploadGuard\UploadInspector"/>
            <argument type="service" id="shopware_media.media_service"/>
            <tag name="shopware.event_subscriber"/>
        </service>
    </services>
</container>
