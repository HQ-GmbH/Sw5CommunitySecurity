{
    "name": "hqgmbh/sw5-community-security",
    "description": "Open-source security plugin for Shopware 5.7.19+ with a modular design; included modules: HTTP security headers, template guard, upload hardening. Independent open-source project initiated and currently maintained by HQ GmbH, open to community contributions; not affiliated with shopware AG.",
    "type": "shopware-plugin",
    "license": "GPL-3.0-only",
    "keywords": ["shopware", "shopware5", "security", "plugin", "hardening", "http-headers"],
    "homepage": "https://github.com/HQ-GmbH/Sw5CommunitySecurity",
    "authors": [
        {
            "name": "HQ GmbH",
            "homepage": "https://www.hqgmbh.de"
        }
    ],
    "support": {
        "issues": "https://github.com/HQ-GmbH/Sw5CommunitySecurity/issues",
        "source": "https://github.com/HQ-GmbH/Sw5CommunitySecurity",
        "security": "https://github.com/HQ-GmbH/Sw5CommunitySecurity/security/policy"
    },
    "require": {
        "php": "^7.4 || ^8.0",
        "composer/installers": "^1.0 || ^2.0"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.95",
        "kubawerlos/php-cs-fixer-custom-fixers": "^3.37",
        "phpstan/phpstan": "^2.3",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "phpstan/phpstan-phpunit": "^2.1",
        "phpstan/phpstan-strict-rules": "^2.1",
        "phpunit/phpunit": "^10.5"
    },
    "autoload-dev": {
        "psr-4": {
            "Sw5CommunitySecurity\\": ""
        }
    },
    "extra": {
        "installer-name": "Sw5CommunitySecurity"
    },
    "config": {
        "sort-packages": true,
        "platform": {
            "php": "8.1.0"
        },
        "allow-plugins": {
            "composer/installers": true
        }
    }
}
