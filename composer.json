{
    "name": "hqgmbh/sw5-community-security",
    "description": "Independent open-source security plugin for Shopware 5.7.19+: modular security fixes, request hardening and HTTP security headers. Not affiliated with shopware AG.",
    "type": "shopware-plugin",
    "license": "GPL-3.0-only",
    "keywords": ["shopware", "shopware5", "security", "plugin", "hardening", "http-headers"],
    "homepage": "https://github.com/HQ-GmbH/Sw5CommunitySecurity",
    "authors": [
        {
            "name": "HQ GmbH",
            "homepage": "https://www.hqgmbh.de"
        }
    ],
    "support": {
        "issues": "https://github.com/HQ-GmbH/Sw5CommunitySecurity/issues",
        "source": "https://github.com/HQ-GmbH/Sw5CommunitySecurity",
        "security": "https://github.com/HQ-GmbH/Sw5CommunitySecurity/security/policy"
    },
    "require": {
        "php": "^8.1",
        "composer/installers": "^1.0 || ^2.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload-dev": {
        "psr-4": {
            "Sw5CommunitySecurity\\": ""
        }
    },
    "extra": {
        "installer-name": "Sw5CommunitySecurity"
    },
    "config": {
        "sort-packages": true,
        "platform": {
            "php": "8.1.0"
        },
        "allow-plugins": {
            "composer/installers": true
        }
    }
}
