# Shared PHPStan settings, included by phpstan.neon.dist (Shopware 5.7) and
# phpstan-sw56.neon.dist (Shopware 5.6). Stricter than the Shopware 5 core,
# which analyses itself with level 8 (.phpstan.neon in shopware5/shopware,
# v5.7.20): level max plus strict, deprecation and PHPUnit rules, no baseline.

includes:
    - vendor/phpstan/phpstan-strict-rules/rules.neon
    - vendor/phpstan/phpstan-deprecation-rules/rules.neon
    - vendor/phpstan/phpstan-phpunit/extension.neon
    - vendor/phpstan/phpstan-phpunit/rules.neon

parameters:
    level: max
    phpVersion:
        min: 70400
        max: 80299
    paths:
        - Commands
        - Controllers
        - Components
        - DependencyInjection
        - Subscriber
        - Sw5CommunitySecurity.php
    bootstrapFiles:
        - %env.SHOPWARE_ROOT%/autoload.php
    scanDirectories:
        - %env.SHOPWARE_ROOT%/engine
    # Same as the Shopware core: PHPDoc types of Shopware are not always reliable.
    treatPhpDocTypesAsCertain: false
    reportUnmatchedIgnoredErrors: true
    checkMissingCallableSignature: true
    checkUninitializedProperties: true
    checkTooWideReturnTypesInProtectedAndPublicMethods: true
    checkImplicitMixed: true
    checkBenevolentUnionTypes: true
    reportPossiblyNonexistentGeneralArrayOffset: true
    reportPossiblyNonexistentConstantArrayOffset: true
    reportAlwaysTrueInLastCondition: true
    reportAnyTypeWideningInVarTag: true
